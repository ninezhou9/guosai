<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', padding: 0 }}>
    {/* 连线层：置于最底，节点覆盖其上 */}
    <svg width={1280} height={720} viewBox='0 0 1280 720' style={{ position: 'absolute', top: 0, left: 0 }}>
        {/* 第一阶段内部箭头 */}
        <path d='M410 215 H 441' stroke='#1E4FA8' strokeWidth='2.5' fill='none' />
        <polygon points='439,206 455,215 439,224' fill='#1E4FA8' />
        <path d='M825 215 H 856' stroke='#1E4FA8' strokeWidth='2.5' fill='none' />
        <polygon points='854,206 870,215 854,224' fill='#1E4FA8' />
        {/* 阶段衔接：全天计划固定 */}
        <path d='M1055 290 V 314 H 225 V 356' stroke='#1E4FA8' strokeWidth='2.5' fill='none' />
        <polygon points='216,352 234,352 225,366' fill='#1E4FA8' />
        {/* 第二阶段内部箭头 */}
        <path d='M410 439 H 441' stroke='#1E4FA8' strokeWidth='2.5' fill='none' />
        <polygon points='439,430 455,439 439,448' fill='#1E4FA8' />
        <path d='M825 439 H 856' stroke='#1E4FA8' strokeWidth='2.5' fill='none' />
        <polygon points='854,430 870,439 854,448' fill='#1E4FA8' />
        {/* 汇入输出 */}
        <path d='M1055 514 V 526' stroke='#1E4FA8' strokeWidth='2.5' fill='none' />
        <polygon points='1046,524 1064,524 1055,538' fill='#1E4FA8' />
    </svg>

    {/* A 页眉 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 72, background: '#1E4FA8' }} />
    <Text style={{ position: 'absolute', top: 18, left: 40, fontSize: 30, fontWeight: 'bold', color: '#FFFFFF' }}>第二问：概率净负荷预测与随机动态规划调度方法</Text>

    {/* 阶段一标签 */}
    <Box style={{
        position: 'absolute', top: 96, left: 40, width: 560, height: 36,
        background: '#1E4FA8', borderRadius: 18, justifyContent: 'center', alignItems: 'center',
    }}>
        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>第一阶段｜日前 0:00：仅凭历史信息确定全天购电计划</Text>
    </Box>

    {/* 阶段二标签 */}
    <Box style={{
        position: 'absolute', top: 320, left: 740, width: 500, height: 36,
        background: '#1E4FA8', borderRadius: 18, justifyContent: 'center', alignItems: 'center',
    }}>
        <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>第二阶段｜日内：每 10 分钟闭环的反馈控制</Text>
    </Box>

    {/* 衔接说明 */}
    <Text style={{ position: 'absolute', top: 288, left: 430, width: 300, fontSize: 15, fontWeight: 'bold', color: '#3D7BD9', textAlign: 'center' }}>全天购电计划固定不变</Text>

    {/* ---------- 第一阶段节点 ---------- */}
    <Box style={{
        position: 'absolute', top: 140, left: 40, width: 370, height: 150,
        background: '#F0F5FC', border: '2px solid #1E4FA8', borderRadius: 8,
        padding: 16, flexDirection: 'column', gap: 8,
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
            </Box>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C' }}>历史信息与特征构造</Text>
        </Box>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5 }}>只使用当日之前的数据：时段与星期周期、昨日与上周同刻、近 3 日与 7 日滚动统计，共约 25 维特征</Text>
    </Box>

    <Box style={{
        position: 'absolute', top: 140, left: 455, width: 370, height: 150,
        background: '#F0F5FC', border: '2px solid #1E4FA8', borderRadius: 8,
        padding: 16, flexDirection: 'column', gap: 8,
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
            </Box>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C' }}>LightGBM 分位数回归</Text>
        </Box>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5 }}>每日拟合 7 个模型，输出 0.20 / 0.50 / 0.65 / 0.80 / 0.90 分位及负荷、光伏中位数；样本按时间指数加权</Text>
    </Box>

    <Box style={{
        position: 'absolute', top: 140, left: 870, width: 370, height: 150,
        background: '#F0F5FC', border: '2px solid #1E4FA8', borderRadius: 8,
        padding: 16, flexDirection: 'column', gap: 8,
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
            </Box>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C' }}>预测中心修正与分时段校准</Text>
        </Box>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5 }}>以 1 月 15—21 日 MAE 选择预测中心（本次为分开预测）；按 4 个 6 小时块做残差分位校准，排序消除分位交叉</Text>
    </Box>

    {/* ---------- 第二阶段节点 ---------- */}
    <Box style={{
        position: 'absolute', top: 364, left: 40, width: 370, height: 150,
        background: '#F0F5FC', border: '2px solid #1E4FA8', borderRadius: 8,
        padding: 16, flexDirection: 'column', gap: 8,
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>4</Text>
            </Box>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C' }}>固定 80 分位日前线性规划</Text>
        </Box>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5 }}>以 80 分位净需求为确定性输入，最小化购电费用；含库存与功率约束；输出全天普通购电计划</Text>
    </Box>

    <Box style={{
        position: 'absolute', top: 364, left: 455, width: 370, height: 150,
        background: '#F0F5FC', border: '2px solid #1E4FA8', borderRadius: 8,
        padding: 16, flexDirection: 'column', gap: 8,
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>5</Text>
            </Box>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C' }}>三状态误差模型与转移矩阵</Text>
        </Box>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5 }}>标准化误差按上下阈值分为三态；全局计数加 1 平滑，再用前后各 3 时段局部计数修正；类内最多 7 个加权样本</Text>
    </Box>

    <Box style={{
        position: 'absolute', top: 364, left: 870, width: 370, height: 150,
        background: '#E8EFF8', border: '2px solid #1E4FA8', borderRadius: 8,
        padding: 16, flexDirection: 'column', gap: 8,
    }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>6</Text>
            </Box>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0E3F8C' }}>联合 Bellman 递推与反馈执行</Text>
        </Box>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5 }}>161 点库存网格求库存价值函数，终端价值设为零；每 10 分钟读实测，富余则充电或弃用，缺口则放电＋应急购电</Text>
    </Box>

    {/* ---------- 底部：口径 与 输出 ---------- */}
    <Box style={{
        position: 'absolute', top: 540, left: 40, width: 720, height: 96,
        background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 8,
        padding: 14, flexDirection: 'column', gap: 6,
    }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0E3F8C' }}>执行口径与边界条件</Text>
        <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.45 }}>储能 1200—10800 kWh；充放电功率不超过5000 kW，效率均 0.9；应急购电按 5 倍电价结算；决策只用当前与过去观测；不强制日末电量回到日初，日末库存作为次日日初连续接续。</Text>
    </Box>

    <Box style={{
        position: 'absolute', top: 540, left: 780, width: 460, height: 96,
        background: '#E8EFF8', border: '2px solid #1E4FA8', borderRadius: 8,
        padding: 14, flexDirection: 'column', gap: 6,
    }}>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0E3F8C' }}>输出结果</Text>
        <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.45 }}>全天普通购电计划、充放电轨迹、应急购电记录、逐时 SOC 与逐日费用，用于全年账单核算与方案对比。</Text>
    </Box>

    {/* D 页脚 */}
    <Text style={{ position: 'absolute', top: 664, left: 40, width: 900, fontSize: 14, color: '#8B97A8' }}>数据来源：附件 1 分时电价、附件 2 负荷与光伏实际功率；对应第二问完整重跑方案</Text>
    <Text style={{ position: 'absolute', top: 662, left: 1200, width: 40, fontSize: 16, color: '#0E3F8C', textAlign: 'right' }}>1 / 1</Text>
</Slide>
